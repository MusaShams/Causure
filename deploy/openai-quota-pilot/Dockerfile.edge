FROM caddy@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648

LABEL org.opencontainers.image.title="Causure quota TLS edge" \
      org.opencontainers.image.version="2.11.4-causure1" \
      org.opencontainers.image.vendor="Causure contributors"

RUN setcap -r /usr/bin/caddy \
    && test -z "$(getcap /usr/bin/caddy)"

USER 65532:65532
WORKDIR /tmp

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
