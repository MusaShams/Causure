{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure approval verification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "verified"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "const": "application/vnd.causure.approval-assertion+json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "media_type",
        "sha256",
        "byte_count"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        }
      },
      "required": [
        "authority_id",
        "key_id"
      ]
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity_provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        },
        "authentication_method": {
          "enum": [
            "azure_devops_approval",
            "organizational_sso"
          ]
        },
        "authentication_event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        },
        "authenticated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      },
      "required": [
        "identity_provider",
        "subject_id",
        "authentication_method",
        "authentication_event_id",
        "authenticated_at"
      ]
    },
    "action": {
      "enum": [
        "approve",
        "exception"
      ]
    },
    "gate_effect": {
      "const": "record_only"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "const": "application/vnd.causure.azure-review-publication+json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "const": "application/vnd.causure.azure-review-verification+json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ]
        }
      },
      "required": [
        "publication",
        "verification"
      ]
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "tfvc": {
      "$ref": "#/$defs/tfvc"
    },
    "build_id": {
      "type": "integer",
      "minimum": 1
    },
    "trust_store_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
    },
    "revocation_list_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
    },
    "revocation_list_updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "finding_codes",
        "justification"
      ]
    }
  },
  "required": [
    "schema_version",
    "verifier_version",
    "status",
    "checked_at",
    "assertion",
    "authority",
    "approver",
    "action",
    "gate_effect",
    "issued_at",
    "expires_at",
    "subject",
    "review",
    "tfvc",
    "build_id",
    "trust_store_id",
    "revocation_list_id",
    "revocation_list_updated_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "approve"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "not": {
          "required": [
            "exception"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "exception"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "exception"
        ]
      }
    }
  ],
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_schema_version": {
          "const": "1.0"
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "component": {
          "enum": [
            "system_prompt",
            "tool_description",
            "tool_schema",
            "model_routing",
            "retrieval_configuration",
            "reviewer",
            "verification_step",
            "retry_policy",
            "stopping_policy",
            "memory_policy",
            "tool_implementation",
            "evaluator",
            "environment",
            "model_reasoning",
            "requirement",
            "other"
          ]
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "decision": {
          "enum": [
            "approve",
            "conditional_pass",
            "reject",
            "needs_evidence",
            "human_review"
          ]
        },
        "recommended_action": {
          "enum": [
            "patch",
            "do_not_patch",
            "collect_evidence",
            "escalate"
          ]
        }
      },
      "required": [
        "result_schema_version",
        "engine_version",
        "policy_name",
        "case_id",
        "component",
        "input_sha256",
        "reviewed_at",
        "decision",
        "recommended_action"
      ]
    },
    "tfvc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server_path": {
          "type": "string",
          "pattern": "^\\$/[^/;](?:[^;]*[^/;])?$",
          "maxLength": 512
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "changeset"
                },
                "changeset_id": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "changeset_id"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "shelveset"
                },
                "shelveset_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 320
                }
              },
              "required": [
                "kind",
                "shelveset_name",
                "owner"
              ]
            }
          ]
        }
      },
      "required": [
        "server_path",
        "target"
      ]
    }
  }
}
