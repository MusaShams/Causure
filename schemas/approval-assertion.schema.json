{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure approval assertion",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "assertion_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authority_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        }
      },
      "required": [
        "authority_id",
        "key_id"
      ]
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "identity_provider": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        },
        "subject_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        },
        "authentication_method": {
          "enum": [
            "azure_devops_approval",
            "organizational_sso"
          ]
        },
        "authentication_event_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        },
        "authenticated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        }
      },
      "required": [
        "identity_provider",
        "subject_id",
        "authentication_method",
        "authentication_event_id",
        "authenticated_at"
      ]
    },
    "action": {
      "enum": [
        "approve",
        "exception"
      ]
    },
    "gate_effect": {
      "const": "record_only"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "const": "application/vnd.causure.azure-review-publication+json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ]
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "const": "application/vnd.causure.azure-review-verification+json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ]
        }
      },
      "required": [
        "publication",
        "verification"
      ]
    },
    "revocation_list_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "const": "ed25519"
        },
        "canonicalization": {
          "const": "causure-json-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      },
      "required": [
        "algorithm",
        "canonicalization",
        "value"
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "finding_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        }
      },
      "required": [
        "finding_codes",
        "justification"
      ]
    }
  },
  "required": [
    "schema_version",
    "assertion_id",
    "authority",
    "approver",
    "action",
    "gate_effect",
    "issued_at",
    "expires_at",
    "subject",
    "revocation_list_id",
    "signature"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "approve"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "not": {
          "required": [
            "exception"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "exception"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "required": [
          "exception"
        ]
      }
    }
  ]
}
