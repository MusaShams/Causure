{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure Team HTTP event page",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tenant_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
        },
        "policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
        },
        "policy_revision": {
          "type": "integer",
          "minimum": 1
        },
        "policy_effective_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "policy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "assigned_roles": {
          "type": "array",
          "items": {
            "enum": [
              "investigator",
              "policy_administrator",
              "approver"
            ]
          },
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true
        },
        "head": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tenant_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
            },
            "sequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            },
            "event_sha256": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              ]
            }
          },
          "required": [
            "tenant_id",
            "sequence",
            "event_sha256"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "sequence": {
                    "const": 0
                  }
                },
                "required": [
                  "sequence"
                ]
              },
              "then": {
                "properties": {
                  "event_sha256": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "event_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "tenant_id",
        "policy_id",
        "policy_revision",
        "policy_effective_at",
        "policy_sha256",
        "policy_byte_count",
        "assigned_roles",
        "head"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
          },
          "event_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "decision_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          },
          "principal": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "identity_provider": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
              },
              "subject_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
              }
            },
            "required": [
              "identity_provider",
              "subject_id"
            ]
          },
          "action": {
            "enum": [
              "evidence_read",
              "investigation_write",
              "policy_write",
              "approval_issue",
              "audit_export"
            ]
          },
          "resource": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resource_type": {
                "enum": [
                  "evidence_case",
                  "investigation",
                  "gate_policy",
                  "approval",
                  "audit_export"
                ]
              },
              "resource_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
              }
            },
            "required": [
              "resource_type",
              "resource_id"
            ]
          },
          "authorized": {
            "type": "boolean"
          },
          "authorization_reason": {
            "enum": [
              "role_grant",
              "principal_not_member",
              "role_not_granted"
            ]
          },
          "outcome": {
            "enum": [
              "succeeded",
              "failed",
              "denied"
            ]
          },
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "media_type": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 16777216
              }
            },
            "required": [
              "media_type",
              "sha256",
              "byte_count"
            ]
          },
          "retention": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "class_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
              },
              "retain_until": {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
              }
            },
            "required": [
              "class_id",
              "retain_until"
            ]
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "media_type": {
                "const": "application/vnd.causure.team-access-policy+json"
              },
              "policy_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "byte_count": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4194304
              }
            },
            "required": [
              "media_type",
              "policy_id",
              "revision",
              "sha256",
              "byte_count"
            ]
          }
        },
        "required": [
          "sequence",
          "event_id",
          "event_sha256",
          "decision_id",
          "occurred_at",
          "principal",
          "action",
          "resource",
          "authorized",
          "authorization_reason",
          "outcome",
          "payload",
          "retention",
          "policy"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "authorized": {
                  "const": true
                }
              },
              "required": [
                "authorized"
              ]
            },
            "then": {
              "properties": {
                "authorization_reason": {
                  "const": "role_grant"
                },
                "outcome": {
                  "enum": [
                    "succeeded",
                    "failed"
                  ]
                }
              }
            },
            "else": {
              "properties": {
                "authorization_reason": {
                  "enum": [
                    "principal_not_member",
                    "role_not_granted"
                  ]
                },
                "outcome": {
                  "const": "denied"
                }
              }
            }
          }
        ]
      },
      "maxItems": 100
    },
    "next_before_sequence": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      ]
    }
  },
  "required": [
    "summary",
    "events",
    "next_before_sequence"
  ]
}
