{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure canary policy",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "policy_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "declared_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "confidence_level": {
      "type": "number",
      "minimum": 0.9,
      "maximum": 0.999
    },
    "maximum_looks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "minimum_observation_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 2592000
    },
    "minimum_sample_size_per_cohort": {
      "type": "integer",
      "minimum": 30,
      "maximum": 1000000000
    },
    "evaluator_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@#$%?=&-]{0,511}$"
    },
    "assignment_unit": {
      "enum": [
        "request",
        "session",
        "principal",
        "tenant"
      ]
    },
    "assignment_method": {
      "enum": [
        "randomized",
        "deterministic_hash"
      ]
    },
    "require_sticky_assignment": {
      "type": "boolean"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "metric_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
          },
          "direction": {
            "enum": [
              "higher",
              "lower"
            ]
          },
          "maximum_degradation": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "metric_id",
          "direction",
          "maximum_degradation"
        ]
      },
      "minItems": 1,
      "maxItems": 50
    }
  },
  "required": [
    "schema_version",
    "policy_id",
    "declared_at",
    "confidence_level",
    "maximum_looks",
    "minimum_observation_seconds",
    "minimum_sample_size_per_cohort",
    "evaluator_ref",
    "assignment_unit",
    "assignment_method",
    "require_sticky_assignment",
    "metrics"
  ]
}
