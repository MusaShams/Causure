{
  "$defs": {
    "repository": {
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "owner_id": {
          "minimum": 1,
          "type": "integer"
        },
        "repository_id": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "repository_id",
        "owner_id",
        "full_name"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "annotation_count": {
      "maximum": 50,
      "minimum": 0,
      "type": "integer"
    },
    "check_run_id": {
      "minimum": 1,
      "type": "integer"
    },
    "conclusion": {
      "enum": [
        "success",
        "failure",
        "action_required"
      ]
    },
    "external_id": {
      "maxLength": 255,
      "pattern": "^causure:[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*:[a-f0-9]{16}$",
      "type": "string"
    },
    "head_sha": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "type": "string"
    },
    "html_url": {
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/runs/[1-9][0-9]*$",
      "type": "string"
    },
    "name": {
      "const": "Causure evidence gate"
    },
    "published_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "pull_request_number": {
      "minimum": 1,
      "type": "integer"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "request": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        },
        "media_type": {
          "const": "application/vnd.causure.github-check-run-request+json"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "sha256",
        "byte_count"
      ],
      "type": "object"
    },
    "run_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "published"
    },
    "verification": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        },
        "media_type": {
          "const": "application/vnd.causure.github-review-verification+json"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "sha256",
        "byte_count"
      ],
      "type": "object"
    },
    "workflow_run_id": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "status",
    "published_at",
    "repository",
    "pull_request_number",
    "head_sha",
    "workflow_run_id",
    "run_attempt",
    "check_run_id",
    "name",
    "conclusion",
    "external_id",
    "html_url",
    "annotation_count",
    "request",
    "verification"
  ],
  "title": "Causure GitHub Check Run receipt",
  "type": "object"
}
