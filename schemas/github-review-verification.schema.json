{
  "$defs": {
    "artifacts": {
      "additionalProperties": false,
      "properties": {
        "change_case": {
          "additionalProperties": false,
          "properties": {
            "byte_count": {
              "maximum": 5242880,
              "minimum": 1,
              "type": "integer"
            },
            "media_type": {
              "const": "application/vnd.causure.change-case+json"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ],
          "type": "object"
        },
        "review_report": {
          "additionalProperties": false,
          "properties": {
            "byte_count": {
              "maximum": 2097152,
              "minimum": 1,
              "type": "integer"
            },
            "media_type": {
              "const": "text/markdown; charset=utf-8"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ],
          "type": "object"
        },
        "review_result": {
          "additionalProperties": false,
          "properties": {
            "byte_count": {
              "maximum": 5242880,
              "minimum": 1,
              "type": "integer"
            },
            "media_type": {
              "const": "application/vnd.causure.review-result+json"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ],
          "type": "object"
        }
      },
      "required": [
        "change_case",
        "review_result",
        "review_report"
      ],
      "type": "object"
    },
    "pull_request": {
      "additionalProperties": false,
      "properties": {
        "base_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "base_repository": {
          "$ref": "#/$defs/repository"
        },
        "base_sha": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "type": "string"
        },
        "draft": {
          "type": "boolean"
        },
        "head_ref": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "head_repository": {
          "$ref": "#/$defs/repository"
        },
        "head_sha": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "type": "string"
        },
        "is_fork": {
          "type": "boolean"
        },
        "number": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "number",
        "base_repository",
        "base_ref",
        "base_sha",
        "head_repository",
        "head_ref",
        "head_sha",
        "is_fork",
        "draft"
      ],
      "type": "object"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "owner_id": {
          "minimum": 1,
          "type": "integer"
        },
        "repository_id": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "repository_id",
        "owner_id",
        "full_name"
      ],
      "type": "object"
    },
    "review": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
          "type": "string"
        },
        "component": {
          "enum": [
            "system_prompt",
            "tool_description",
            "tool_schema",
            "model_routing",
            "retrieval_configuration",
            "reviewer",
            "verification_step",
            "retry_policy",
            "stopping_policy",
            "memory_policy",
            "tool_implementation",
            "evaluator",
            "environment",
            "model_reasoning",
            "requirement",
            "other"
          ]
        },
        "decision": {
          "enum": [
            "approve",
            "conditional_pass",
            "reject",
            "needs_evidence",
            "human_review"
          ]
        },
        "engine_version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "policy_name": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "recommended_action": {
          "enum": [
            "patch",
            "do_not_patch",
            "collect_evidence",
            "escalate"
          ]
        },
        "result_schema_version": {
          "const": "1.0"
        },
        "reviewed_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "type": "string"
        }
      },
      "required": [
        "result_schema_version",
        "engine_version",
        "policy_name",
        "case_id",
        "component",
        "input_sha256",
        "reviewed_at",
        "decision",
        "recommended_action"
      ],
      "type": "object"
    },
    "workflow": {
      "additionalProperties": false,
      "properties": {
        "event_action": {
          "enum": [
            "opened",
            "ready_for_review",
            "reopened",
            "synchronize"
          ]
        },
        "event_name": {
          "const": "pull_request"
        },
        "event_payload": {
          "additionalProperties": false,
          "properties": {
            "byte_count": {
              "maximum": 26214400,
              "minimum": 1,
              "type": "integer"
            },
            "media_type": {
              "const": "application/json"
            },
            "sha256": {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ],
          "type": "object"
        },
        "event_sha": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "type": "string"
        },
        "job": {
          "maxLength": 255,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "ref": {
          "maxLength": 512,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "run_attempt": {
          "minimum": 1,
          "type": "integer"
        },
        "run_id": {
          "minimum": 1,
          "type": "integer"
        },
        "run_number": {
          "minimum": 1,
          "type": "integer"
        },
        "server_url": {
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https://[^/?#@]+$",
          "type": "string"
        },
        "workflow_ref": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$",
          "type": "string"
        },
        "workflow_sha": {
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
          "type": "string"
        }
      },
      "required": [
        "server_url",
        "event_name",
        "event_action",
        "event_sha",
        "ref",
        "workflow_ref",
        "workflow_sha",
        "run_id",
        "run_number",
        "run_attempt",
        "job",
        "event_payload"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    },
    "maximum_age_seconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
    },
    "publication": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        },
        "media_type": {
          "const": "application/vnd.causure.github-review-publication+json"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "sha256",
        "byte_count"
      ],
      "type": "object"
    },
    "publication_age_seconds": {
      "maximum": 86400,
      "minimum": 0,
      "type": "integer"
    },
    "pull_request": {
      "$ref": "#/$defs/pull_request"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "verified"
    },
    "verified_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "workflow": {
      "$ref": "#/$defs/workflow"
    }
  },
  "required": [
    "schema_version",
    "status",
    "verified_at",
    "maximum_age_seconds",
    "publication_age_seconds",
    "publication",
    "review",
    "pull_request",
    "workflow",
    "artifacts"
  ],
  "title": "Causure GitHub review verification",
  "type": "object"
}
