{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure Azure review verification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "status": {
      "const": "verified"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "maximum_age_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "publication_age_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "const": "application/vnd.causure.azure-review-publication+json"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "byte_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "media_type",
        "sha256",
        "byte_count"
      ]
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "tfvc": {
      "$ref": "#/$defs/tfvc"
    },
    "build_id": {
      "type": "integer",
      "minimum": 1
    },
    "artifacts": {
      "$ref": "#/$defs/artifacts"
    }
  },
  "required": [
    "schema_version",
    "status",
    "verified_at",
    "maximum_age_seconds",
    "publication_age_seconds",
    "publication",
    "review",
    "tfvc",
    "build_id",
    "artifacts"
  ],
  "$defs": {
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_schema_version": {
          "const": "1.0"
        },
        "engine_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "policy_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "case_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
        },
        "component": {
          "enum": [
            "system_prompt",
            "tool_description",
            "tool_schema",
            "model_routing",
            "retrieval_configuration",
            "reviewer",
            "verification_step",
            "retry_policy",
            "stopping_policy",
            "memory_policy",
            "tool_implementation",
            "evaluator",
            "environment",
            "model_reasoning",
            "requirement",
            "other"
          ]
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
        },
        "decision": {
          "enum": [
            "approve",
            "conditional_pass",
            "reject",
            "needs_evidence",
            "human_review"
          ]
        },
        "recommended_action": {
          "enum": [
            "patch",
            "do_not_patch",
            "collect_evidence",
            "escalate"
          ]
        }
      },
      "required": [
        "result_schema_version",
        "engine_version",
        "policy_name",
        "case_id",
        "component",
        "input_sha256",
        "reviewed_at",
        "decision",
        "recommended_action"
      ]
    },
    "tfvc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "server_path": {
          "type": "string",
          "pattern": "^\\$/[^/;](?:[^;]*[^/;])?$",
          "maxLength": 512
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "changeset"
                },
                "changeset_id": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "required": [
                "kind",
                "changeset_id"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "shelveset"
                },
                "shelveset_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "owner": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 320
                }
              },
              "required": [
                "kind",
                "shelveset_name",
                "owner"
              ]
            }
          ]
        }
      },
      "required": [
        "server_path",
        "target"
      ]
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "review_result": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "const": "application/vnd.causure.review-result+json"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5242880
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ]
        },
        "review_report": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "media_type": {
              "const": "text/markdown; charset=utf-8"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "byte_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2097152
            }
          },
          "required": [
            "media_type",
            "sha256",
            "byte_count"
          ]
        }
      },
      "required": [
        "review_result",
        "review_report"
      ]
    }
  }
}
