{
  "$defs": {
    "finding": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
          "type": "string"
        },
        "consequence": {
          "enum": [
            "conditional",
            "needs_evidence",
            "reject",
            "human_review"
          ]
        },
        "end_line": {
          "minimum": 1,
          "type": "integer"
        },
        "message": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!/)(?!.*//)(?![^/]*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+[^/\\\\\\u0000-\\u001f\\u007f]$|^[^/\\\\:\\u0000-\\u001f\\u007f]$",
          "type": "string"
        },
        "start_line": {
          "minimum": 1,
          "type": "integer"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "warning"
          ]
        }
      },
      "required": [
        "code",
        "status",
        "consequence",
        "path",
        "start_line",
        "end_line",
        "message"
      ],
      "type": "object"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "maxLength": 255,
          "minLength": 3,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "owner_id": {
          "minimum": 1,
          "type": "integer"
        },
        "repository_id": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "repository_id",
        "owner_id",
        "full_name"
      ],
      "type": "object"
    },
    "review": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
          "type": "string"
        },
        "component": {
          "enum": [
            "system_prompt",
            "tool_description",
            "tool_schema",
            "model_routing",
            "retrieval_configuration",
            "reviewer",
            "verification_step",
            "retry_policy",
            "stopping_policy",
            "memory_policy",
            "tool_implementation",
            "evaluator",
            "environment",
            "model_reasoning",
            "requirement",
            "other"
          ]
        },
        "decision": {
          "enum": [
            "approve",
            "conditional_pass",
            "reject",
            "needs_evidence",
            "human_review"
          ]
        },
        "engine_version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "input_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "policy_name": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        "recommended_action": {
          "enum": [
            "patch",
            "do_not_patch",
            "collect_evidence",
            "escalate"
          ]
        },
        "result_schema_version": {
          "const": "1.0"
        },
        "reviewed_at": {
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$",
          "type": "string"
        }
      },
      "required": [
        "result_schema_version",
        "engine_version",
        "policy_name",
        "case_id",
        "component",
        "input_sha256",
        "reviewed_at",
        "decision",
        "recommended_action"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "allow_conditional": {
      "type": "boolean"
    },
    "conclusion": {
      "enum": [
        "success",
        "failure",
        "action_required"
      ]
    },
    "created_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "details_url": {
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]*$",
      "type": "string"
    },
    "external_id": {
      "maxLength": 255,
      "pattern": "^causure:[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*:[1-9][0-9]*:[a-f0-9]{16}$",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/finding"
      },
      "maxItems": 50,
      "type": "array"
    },
    "head_sha": {
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$",
      "type": "string"
    },
    "is_fork": {
      "type": "boolean"
    },
    "name": {
      "const": "Causure evidence gate"
    },
    "pull_request_number": {
      "minimum": 1,
      "type": "integer"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "run_attempt": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0"
    },
    "verification": {
      "additionalProperties": false,
      "properties": {
        "byte_count": {
          "maximum": 1048576,
          "minimum": 1,
          "type": "integer"
        },
        "media_type": {
          "const": "application/vnd.causure.github-review-verification+json"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "sha256",
        "byte_count"
      ],
      "type": "object"
    },
    "workflow_run_id": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "created_at",
    "repository",
    "pull_request_number",
    "head_sha",
    "is_fork",
    "workflow_run_id",
    "run_attempt",
    "verification",
    "review",
    "allow_conditional",
    "name",
    "conclusion",
    "details_url",
    "external_id",
    "findings"
  ],
  "title": "Causure GitHub Check Run request",
  "type": "object"
}
