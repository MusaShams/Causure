{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure Team HTTP action request",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "evidence_read",
        "investigation_write",
        "policy_write",
        "approval_issue",
        "audit_export"
      ]
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "evidence_case",
            "investigation",
            "gate_policy",
            "approval",
            "audit_export"
          ]
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
        }
      },
      "required": [
        "type",
        "id"
      ]
    },
    "outcome": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,126}/[a-z0-9][a-z0-9!#$&^_.+-]{0,126}$"
        },
        "base64url": {
          "type": "string",
          "minLength": 2,
          "maxLength": 22369624,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2}|[A-Za-z0-9_-]{3}|[A-Za-z0-9_-]{4})$"
        }
      },
      "required": [
        "media_type",
        "base64url"
      ]
    },
    "expected_head_sha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      ]
    },
    "retention_class_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/@-]{0,127}$"
    }
  },
  "required": [
    "action",
    "resource",
    "outcome",
    "payload",
    "expected_head_sha256"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "evidence_read"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "type": {
                "enum": [
                  "evidence_case",
                  "investigation"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "investigation_write"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "type": {
                "enum": [
                  "investigation"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "policy_write"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "type": {
                "enum": [
                  "gate_policy"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "approval_issue"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "type": {
                "enum": [
                  "approval"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "audit_export"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "resource": {
            "properties": {
              "type": {
                "enum": [
                  "audit_export"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
