{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure policy override",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "default": "default-v1"
    },
    "min_reproduction_trials": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "min_reproduction_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.67
    },
    "require_independent_oracle": {
      "type": "boolean",
      "default": true
    },
    "min_attribution_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.7
    },
    "min_attribution_margin": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.15
    },
    "min_intervention_trials": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "min_intervention_success_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.67
    },
    "require_isolated_intervention": {
      "type": "boolean",
      "default": true
    },
    "max_changed_surfaces": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "min_positive_controls": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "min_positive_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "min_negative_controls": {
      "type": "integer",
      "minimum": 1,
      "default": 1
    },
    "min_negative_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 1.0
    },
    "min_regression_controls": {
      "type": "integer",
      "minimum": 1,
      "default": 3
    },
    "min_regression_pass_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "default": 0.98
    },
    "allow_critical_regressions": {
      "type": "boolean",
      "default": false
    },
    "require_metrics_for_approval": {
      "type": "boolean",
      "default": true
    },
    "max_cost_increase_ratio": {
      "type": "number",
      "minimum": 0,
      "default": 0.1
    },
    "max_latency_increase_ratio": {
      "type": "number",
      "minimum": 0,
      "default": 0.15
    },
    "block_on_metric_regression": {
      "type": "boolean",
      "default": false
    }
  }
}
