{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure approval trust store",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "store_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
    },
    "revocation_list_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
    },
    "keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
          },
          "authority_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
          },
          "algorithm": {
            "const": "ed25519"
          },
          "public_key_base64url": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$"
          },
          "valid_from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          },
          "valid_until": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          },
          "allowed_actions": {
            "type": "array",
            "items": {
              "enum": [
                "approve",
                "exception"
              ]
            },
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true
          }
        },
        "required": [
          "key_id",
          "authority_id",
          "algorithm",
          "public_key_base64url",
          "valid_from",
          "valid_until",
          "allowed_actions"
        ]
      },
      "minItems": 1,
      "maxItems": 1000
    }
  },
  "required": [
    "schema_version",
    "store_id",
    "revocation_list_id",
    "keys"
  ]
}
