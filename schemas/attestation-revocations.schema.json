{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure attestation revocation list",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "list_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "revoked_keys": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
          },
          "mode": {
            "enum": [
              "all_signatures",
              "issued_at_or_after"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "required": [
          "key_id",
          "revoked_at",
          "mode",
          "reason"
        ]
      },
      "maxItems": 10000
    }
  },
  "required": [
    "schema_version",
    "list_id",
    "updated_at",
    "revoked_keys"
  ]
}
