{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Causure sandbox worker request",
  "$defs": {
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 86400
        },
        "max_concurrency": {
          "const": 1
        },
        "max_cases": {
          "const": 1
        },
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "timeout_seconds",
        "max_concurrency",
        "max_cases"
      ]
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lease_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:+/-]{2,127}$"
        },
        "lease_token": {
          "type": "string",
          "minLength": 16,
          "maxLength": 8192,
          "pattern": "^\\S+$",
          "writeOnly": true
        },
        "proxy_url": {
          "type": "string",
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://[A-Za-z0-9][A-Za-z0-9.-]*(?::[0-9]{1,5})?(?:/[^?#]*)?$"
        }
      },
      "required": [
        "lease_id",
        "lease_token",
        "proxy_url"
      ]
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "input_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "quota": {
          "$ref": "#/$defs/quota"
        },
        "mode": {
          "const": "replay"
        },
        "baseline_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "candidate_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      },
      "required": [
        "schema_version",
        "mode",
        "case_id",
        "input_ref",
        "budget",
        "baseline_ref",
        "candidate_ref",
        "seed"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "case_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "input_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "quota": {
          "$ref": "#/$defs/quota"
        },
        "mode": {
          "const": "evaluation"
        },
        "evaluator_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "schema_version",
        "mode",
        "case_id",
        "input_ref",
        "budget",
        "evaluator_ref"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/replay"
    },
    {
      "$ref": "#/$defs/evaluation"
    }
  ]
}
